# Setu Finance - PROD environment. Copy to .env.prod and fill in. Keep OUT of git.
# chmod 600 .env.prod

# --- Public address (must match SITE_ADDRESS form in Caddyfile) ---
SITE_ADDRESS=finance.example.com

# --- App ---
PORT=8787

# --- Postgres (api connects over the compose network) ---
# DB_PASSWORD is read by compose for both the postgres container and DATABASE_URL.
DB_PASSWORD=change-me-strong-db-password
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Production starts from a clean schema and your restored data.
# Set to true ONLY if you want the bundled demo data on first boot.
DB_SEED_ON_BOOT=false
DB_SEED_SOURCE=server/storage/app-state.json

# --- Portal login ---
AUTH_SESSION_SECRET=change-me-long-random-string
PORTAL_USERNAME=admin
PORTAL_PASSWORD=change-me-strong-portal-password

# --- Outbound email (Gmail App Password path; leave blank to disable) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Invoice content ---
ZELLE_PAY_TO=
CARD_PAYMENT_BASE_URL=

# --- Contract storage (set to move uploaded contracts into a private S3 bucket) ---
CONTRACTS_S3_BUCKET=
CONTRACTS_S3_PREFIX=contracts

# --- Gmail / Zelle inbox sync (credentials mounted separately, not in git) ---
GMAIL_CREDENTIALS_PATH=server/credentials/gmail-oauth.json
GMAIL_TOKEN_PATH=server/credentials/gmail-token.json
GMAIL_QUERY='in:inbox subject:"You received money with Zelle"'
GMAIL_MAX_RESULTS=20
GMAIL_INITIAL_LOOKBACK_DAYS=14
GMAIL_SYNC_OVERLAP_MINUTES=15
