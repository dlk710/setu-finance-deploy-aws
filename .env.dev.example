# Setu Finance - DEV environment. Copy to .env.dev and fill in. Keep OUT of git.

# Public address (must match the Caddyfile SITE_ADDRESS form)
SITE_ADDRESS=dev.finance.example.com

PORT=8787

# Postgres
DB_PASSWORD=dev-db-password-change-me
DATABASE_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# In dev it's handy to boot with the bundled demo data.
DB_SEED_ON_BOOT=true
DB_SEED_SOURCE=server/storage/app-state.json

# Portal login
AUTH_SESSION_SECRET=dev-change-me
PORTAL_USERNAME=admin
PORTAL_PASSWORD=dev-portal-password

# Outbound email (leave blank to disable while testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ZELLE_PAY_TO=
CARD_PAYMENT_BASE_URL=

# Contract storage (leave blank to keep contracts on the instance filesystem)
CONTRACTS_S3_BUCKET=
CONTRACTS_S3_PREFIX=contracts

# Gmail / Zelle sync (optional in dev)
GMAIL_CREDENTIALS_PATH=server/credentials/gmail-oauth.json
GMAIL_TOKEN_PATH=server/credentials/gmail-token.json
GMAIL_QUERY='in:inbox subject:"You received money with Zelle"'
GMAIL_MAX_RESULTS=20
GMAIL_INITIAL_LOOKBACK_DAYS=14
GMAIL_SYNC_OVERLAP_MINUTES=15
